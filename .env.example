# Runtime environment; use local for desktop development or docker in a container.
ENV=local

# Kite Connect credentials
KITE_API_KEY=
KITE_API_SECRET=
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Gemini integration
GEMINI_API_KEY=
