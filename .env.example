# Runtime environment; use local for desktop development or docker in a container.
ENV=local

# Dashboard login. Required when ENV=production. Use a unique random secret
# (at least 32 characters) and do not commit a populated .env file.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Kite Connect credentials
KITE_API_KEY=
KITE_API_SECRET=
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Gemini integration
GEMINI_API_KEY=
